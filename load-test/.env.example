# Must point at the same database, and use the same JWT_SECRET, as backend/.env —
# otherwise tokens signed here won't validate against the running API.
DATABASE_URL="postgresql://navi:navi@localhost:5432/navi?schema=public"
JWT_SECRET="change-me-to-a-long-random-string"

# Target scale for the real load test. Override with smaller values for local
# dry runs (e.g. TOTAL_USERS=500000 TOTAL_BUSINESSES=10000 npm run seed) —
# a single-node local Postgres container has no business ingesting 100M rows.
TOTAL_USERS=100000000
TOTAL_BUSINESSES=2000000
AVG_REVIEWS_PER_BUSINESS=5
MAX_REVIEWS_PER_BUSINESS=200

# COPY batch size — rows buffered per streamed chunk. Tune down on constrained hosts.
COPY_BATCH_SIZE=50000

# Token pool size should match your target peak concurrent VUs, not TOTAL_USERS —
# you never need one token per registered user, just enough to cycle through.
TOKEN_POOL_SIZE=20000
TOKEN_TTL=30d
BUSINESS_SAMPLE_SIZE=5000
