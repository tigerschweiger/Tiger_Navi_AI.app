DATABASE_URL="postgresql://navi:navi@localhost:5432/navi?schema=public"
JWT_SECRET="change-me-to-a-long-random-string"
PORT=4000

# Connections each process opens to Postgres (appended to DATABASE_URL as
# ?connection_limit=). Keep CLUSTER_WORKERS * DB_POOL_SIZE comfortably under
# Postgres's max_connections (default 100) — e.g. 8 workers * 10 = 80.
DB_POOL_SIZE=10

# Fork this many worker processes (Node's cluster module) so the app tier
# uses more than one CPU core. 1 = today's single-process behavior (default,
# used by `npm run dev`). For load tests / production, build first and run
# the compiled output: `npm run build && CLUSTER_WORKERS=8 npm start`
# (tsx's dev watcher doesn't cooperate well with cluster forking).
CLUSTER_WORKERS=1

# TCP accept-queue depth passed to listen(). Also capped by the OS's own
# net.core.somaxconn (Linux) regardless of this value — under a burst of
# thousands of near-simultaneous connections (e.g. k6 ramping to 5000+ VUs
# from a remote machine), a too-small queue on either side shows up as
# client-side "connection reset by peer" / timeouts, not app latency — see
# load-test/README.md's OS tuning section for the matching sysctl/ulimit
# commands to raise on both the server and the load-generator machine.
LISTEN_BACKLOG=1024

# Public OSM services used for v1. Swap these for a self-hosted or paid
# provider (LocationIQ / Geoapify / Mapbox) once traffic outgrows the
# public usage policy (~1 req/sec, no heavy/production use).
NOMINATIM_BASE_URL="https://nominatim.openstreetmap.org"
OSRM_BASE_URL="https://router.project-osrm.org"

# Used by /api/businesses/:id/summary to AI-summarize a business's reviews.
# Get a key at https://console.anthropic.com/ (or run `ant auth login`, which
# the SDK also picks up automatically without setting this at all).
ANTHROPIC_API_KEY=""
