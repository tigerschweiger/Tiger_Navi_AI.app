DATABASE_URL="postgresql://navi:navi@localhost:5432/navi?schema=public"
JWT_SECRET="change-me-to-a-long-random-string"
PORT=4000

# Public OSM services used for v1. Swap these for a self-hosted or paid
# provider (LocationIQ / Geoapify / Mapbox) once traffic outgrows the
# public usage policy (~1 req/sec, no heavy/production use).
NOMINATIM_BASE_URL="https://nominatim.openstreetmap.org"
OSRM_BASE_URL="https://router.project-osrm.org"

# Used by /api/businesses/:id/summary to AI-summarize a business's reviews.
# Get a key at https://console.anthropic.com/ (or run `ant auth login`, which
# the SDK also picks up automatically without setting this at all).
ANTHROPIC_API_KEY=""
